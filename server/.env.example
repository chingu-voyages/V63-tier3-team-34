PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Login with GitHub. Create the OAuth app at https://github.com/settings/developers
# (OAuth Apps -> New OAuth App) and register this callback URL, which uses CLIENT_ORIGIN:
#   <CLIENT_ORIGIN>/api/auth/github/callback   e.g. http://localhost:5173/api/auth/github/callback
# No quotes or spaces around the values. Restart the server after changing them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
