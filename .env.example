# Copy to .env and adjust as needed. All values have defaults in docker-compose.yml.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Host ports
SERVER_PORT=3000
CLIENT_PORT=8080

# Origin the server allows for CORS (the client's URL as seen by the browser)
CLIENT_ORIGIN=http://localhost:8080
CLIENT_DEV_PORT=5173

# Login with GitHub. Register <CLIENT_ORIGIN>/api/auth/github/callback as the callback URL of
# the OAuth app (see server/.env.example for where to create it).
# `make dev` serves the client on http://localhost:5173, `make up` on http://localhost:8080.
# For `make dev` these two can live in server/.env instead; `make up` only reads this file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
