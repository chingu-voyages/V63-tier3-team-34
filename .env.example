# Copy to .env and adjust as needed. All values have defaults in docker-compose.yml.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Host ports
SERVER_PORT=3000
CLIENT_PORT=8080

# Origin the server allows for CORS (the client's URL as seen by the browser)
CLIENT_ORIGIN=http://localhost:8080
CLIENT_DEV_PORT=5173
